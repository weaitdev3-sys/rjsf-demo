            { "id": "medical-history", "kind": "textarea", "label": "Medical history" },
            { "id": "personal-preferences", "kind": "textarea", "label": "Personal preferences" }
          ]
        },
        {
          "id": "emergency",
          "kind": "container",
          "label": "Emergency plan",
          "children": [
            { "id": "call-emergency", "kind": "checkbox", "label": "Call 000 in emergencies" },
            {
              "id": "alternative-residency",
              "kind": "checkbox",
              "label": "Has alternative place to stay"
            },
            {
              "id": "alternative-address",
              "kind": "textarea",
              "label": "Alternative residential address",
              "visibility": { "controllerId": "alternative-residency", "operator": "isChecked" }
            }
          ]
        },
        {
          "id": "services",
          "kind": "multiSelect",
